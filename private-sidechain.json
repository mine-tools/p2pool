{
    // 私有侧链配置示例 —— 用 --sidechain-config 加载，使本节点成为一条
    // 与公共 p2pool(default/mini/nano)完全隔离的、全新的独立侧链。
    //
    // 隔离原理：下面任意字段与公共链不同，算出的 consensus ID 就不同，
    // 公共网络的节点无法与你握手，也不会加载公共 DNS 种子节点。
    //
    // 注意：name + password 是这条私有链的“身份”。想让多台机器组成同一条
    //       私有链，所有机器必须使用【完全相同】的本配置；password 相当于
    //       加入这条链的口令，不要泄露。

    // 侧链名称（必改成你自己的唯一名字，不能用 default/mini/nano）
    "name": "my-private-pool",

    // 加入这条私有链的口令（留空也行，但建议设一个随机串增强隔离/防蹭）
    "password": "change-this-to-a-random-secret",

    // 侧链目标出块间隔（秒）。越小份额越频繁、链增长越快。默认 10。
    "block_time": 10,

    // 侧链最小难度。应大致等于  全矿池总算力(H/s) × block_time。
    //   例：总算力 10 KH/s、block_time 10s  → 约 100000（即默认值）。
    //   私有/小算力矿池如果设太高，会长时间出不了侧链块。按实际算力调。
    "min_diff": 100000,

    // PPLNS 计酬窗口（侧链块数）。决定份额回溯多长用于分账。默认 2160。
    "pplns_window": 2160,

    // 叔块惩罚百分比。默认 20。
    "uncle_penalty": 20
}
